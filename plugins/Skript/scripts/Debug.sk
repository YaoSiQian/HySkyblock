command /rarity [<text>]:
	permission: admin.admin
	permission message: '&c你没有权限!'
	trigger:
		if arg 1 is set:
			if arg 1 is "uncommon":
				make the player execute command "/itemedit lore set 1 &a&l精良"
				make the player execute command "/itemedit enchant protection 1"
				make the player execute command "/itemedit hide enchants"
				message "&a该物品稀有度已修改为 &l精良&a!"
				stop
			if arg 1 is "rare":
				make the player execute command "/itemedit lore set 1 &9&l稀有"
				make the player execute command "/itemedit enchant protection 1"
				make the player execute command "/itemedit hide enchants"
				message "&a该物品稀有度已修改为 &9&l稀有&a!"
				stop
			else:
				message "&cThe specified rarity does not exist!"
				stop
		else:
			message "&c请输入稀有度! (/rarity <稀有度>)"
			message "&c目前可用的稀有度: 精良(uncommon), 稀有(rare)"
			stop

command /debuguuid:
	aliases: /myuuid, /uuid
	trigger:
		message ""
		message "{debug=Player:%player%,PlayerUUID:%player's uuid%}"
		message ""
		stop

command /debugregion:
	trigger:
		if player is in "Server":
			message ""
			message "{debug=Regions (%amount of regions at player%): %regions at player%&f}"
			message ""
			stop
		else:
			message "&c你不能测试玩家岛屿世界!"
			stop

command /debugblock:
	trigger:
		if targeted block is not set:
			message "&c你不能测试空气!"
			stop
		else:
			message ""
			message "{debug=TargetedBlock: %targeted block%}"
			message ""
			stop

command /debugitem:
	trigger:
		if held item is air:
			message "&c你不能测试空气!"
			stop
		if held item is nether star:
			message "&c你不能测试空岛生存菜单!"
			stop
		else:
			message "{debug=HeldItem: %held item%}"
			stop