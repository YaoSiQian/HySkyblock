command /hub:
	trigger:
		make the player execute command "/spawn"

command /vip:
	trigger:
		send formatted "&e欢迎通过 &e服务器商店 购买 &aVIP &e或其他权益<reset>"

command /help:
	trigger:
		send ""
		send ""
		send "&e&l文明游戏"
		send "&e点击选择帮助选项..."
		send ""
#		send formatted "  &c* <tooltip:&d点击选择!><link:http://mc.server.net/>&bFound a Server Bug/Issue<reset>"
#		send formatted "  &c* <tooltip:&d点击选择!><link:http://mc.server.net/>&bReport a Rule Breaker<reset>"
