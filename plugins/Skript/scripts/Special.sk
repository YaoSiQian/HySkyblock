on rightclick holding a stick:
	if held item's name is "&f平原群系魔杖":
		make the server execute command "/bsbadmin biomes set %player% PLAINS"
		remove 1 of player's tool from player
		send "&7正在切换岛屿的生物群系..." to player
		wait 13 ticks
		send "&7岛屿的生物群系已被切换为 &b平原&7!" to player
		send "&7重新进入岛屿以查看效果!" to player
		stop
	if held item's name is "&f热带草原群系魔杖":
		make the server execute command "/bsbadmin biomes set %player% SAVANNA"
		remove 1 of player's tool from player
		send "&7正在切换岛屿的生物群系..." to player
		wait 13 ticks
		send "&7岛屿的生物群系已被切换为 &b热带草原&7!" to player
		send "&7重新进入岛屿以查看效果!" to player
		stop
	if held item's name is "&f丛林群系魔杖":
		make the server execute command "/bsbadmin biomes set %player% JUNGLE"
		remove 1 of player's tool from player
		send "&7正在切换岛屿的生物群系..." to player
		wait 13 ticks
		send "&7岛屿的生物群系已被切换为 &b丛林&7!" to player
		send "&7重新进入岛屿以查看效果!" to player
		stop
	if held item's name is "&f针叶林群系魔杖":
		make the server execute command "/bsbadmin biomes set %player% TAIGA"
		remove 1 of player's tool from player
		send "&7正在切换岛屿的生物群系..." to player
		wait 13 ticks
		send "&7岛屿的生物群系已被切换为 &b针叶林&7!" to player
		send "&7重新进入岛屿以查看效果!" to player
		stop
	if held item's name is "&f下界群系魔杖":
		make the server execute command "/bsbadmin biomes set %player% NETHER"
		remove 1 of player's tool from player
		send "&7正在切换岛屿的生物群系..." to player
		wait 13 ticks
		send "&7岛屿的生物群系已被切换为 &b下界&7!" to player
		send "&7重新进入岛屿以查看效果!" to player
		stop
	if held item's name is "&f末地群系魔杖":
		make the server execute command "/bsbadmin biomes set %player% END"
		remove 1 of player's tool from player
		send "&7正在切换岛屿的生物群系..." to player
		wait 13 ticks
		send "&7岛屿的生物群系已被切换为 &b末地&7!" to player
		send "&7重新进入岛屿以查看效果!" to player
		stop
	else:
		stop
        
on rightclick holding a bow:
	player has arrow
	held item's name is "&9Artisanal Shortbow":
		cancel event
		make the player shoot an arrow with speed 1.3
		remove 1 arrow from player's inventory
		stop
	else:
		stop

on damage:
	victim is a spider
	attacker is a player
	victim is in "spiders-den"
	chance of 10%:
		push victim upwards at speed 0.6
		wait 1 ticks
		push victim upwards at speed 0.5
		wait 3 ticks
		push the victim forward at speed 1.0

on damage:
	attacker is a player
	projectile exists
	projectile is an arrow
	if name of attacker's tool is "&9Artisanal Shortbow":
		set damage to 20
		stop
	else:
		stop


on damage:
    attacker is a player
    attacker's held item's name is "&f节肢之刃":
        victim is a spider, silverfish or a cave spider:
            set damage to damage * 2
            stop
        else:
            stop
    attacker's held item's name is "&a末地之刃":
        victim is a enderman, ender dragon or endermite:
            set damage to damage * 2
            stop
        else:
            stop
    attacker's held item's name is "&f亡灵之刃":
        if victim is a skeleton, wither skeleton, zombie or zombie pigman:
            set damage to damage * 2
            stop
        else:
            stop

on damage:
	victim is a player
	attacker is a cave spider or a spider
	if name of victim's helmet is "&f蜘蛛头饰":
		set damage to damage * 0.7
		stop
	else:
		stop

on damage:
	attacker is a player
	if name of attacker's helmet is "&f河豚头饰":
		chance of 20%:
			loop all mobs in radius 4 of the attacker:
				wait 1 ticks
				damage loop-entity by 5
				stop
	else:
		stop

on damage:
	victim is a player
	damage cause = potion
	if name of victim's helmet is "&f牛头饰":
		cancel event
		stop
	else:
		stop

on damage:
	victim is a player
	damage cause = poison
	if name of victim's helmet is "&f牛头饰":
		cancel event
		stop
	else:
		stop

on damage:
	attacker is a player
	projectile exists
	projectile is an arrow
	if name of attacker's tool is "&a金合欢木弓":
		set damage to damage * 2.0
		stop
	else:
		stop

on damage:
	attacker is a player
	projectile exists
	projectile is an arrow
	if name of attacker's tool is "&a凋零弓":
		if victim is wither or wither skeleton:
			set damage to damage * 2.0
			stop
		else:
			stop
	else:
		stop

on damage:
	attacker is a player
	victim is not a player
	projectile exists
	projectile is an arrow
	if name of attacker's helmet is "&f骷髅头饰":
		chance of 20%:
			create a fake explosion at the victim
			loop all mobs in radius 3 of the victim:
				damage loop-entity by 20
				stop
			stop
	else:
		stop

on block break:
	if player's held item's name is "&f燧石锹":
		if event-block is GRAVEL:
			if event-block is in "spiders-den":
				clear drops
				drop 1 flint at event-block
				stop
			else:
				stop
		else:
			stop
	else:
		stop

on block break:
	if player's held item's name is "&a苹果斧":
		if event-block is OAK LOG, BIRCH LOG, SPRUCE LOG, DARK OAK LOG, ACACIA LOG or JUNGLE LOG:
			if event-block is in "forest" or "forest-island":
				chance of 30%:
					drop 1 apple at event-block
					stop
			else:
				stop
		else:
			stop
	else:
		stop

on block break:
	if player's held item's name is "&a高效斧":
		if event-block is in "forest" or "forest-island":
			if event-block is OAK LOG:
				clear drops
				drop 5 oak planks at event-block
				stop
			if event-block is BIRCH LOG:
				clear drops
				drop 5 birch planks at event-block
				stop
			if event-block is SPRUCE LOG:
				clear drops
				drop 5 spruce planks at event-block
				stop
			if event-block is DARK OAK LOG:
				clear drops
				drop 5 dark oak planks at event-block
				stop
			if event-block is ACACIA LOG:
				clear drops
				drop 5 acacia planks at event-block
				stop
			if event-block is JUNGLE LOG:
				clear drops
				drop 5 jungle planks at event-block
				stop
			else:
				stop
		else:
			stop
	else:
		stop


on rightclick holding a experience bottle:
    held item's name is "&a大经验瓶":
        make the server execute command "/xp give %player% 800"
        wait 2 ticks
        make the server execute command "/xp give %player% 500"
        wait 3 ticks
        make the server execute command "/xp give %player% 200"
        stop
    held item's name is "&9泰坦经验瓶":
        make the server execute command "/xp give %player% 20800"
        wait 2 ticks
        make the server execute command "/xp give %player% 15500"
        wait 3 ticks
        make the server execute command "/xp give %player% 13500"
        stop
    else:
        stop

on block break:
    held item's name is "&f僵尸镐":
        remove haste from player
        apply haste 2 to the player for 6 seconds
        stop

on damage:
	attacker is a player
	if attacker's held item's name is "&a海晶之刃":
		if block at attacker is water:
			set damage to damage * 3
			stop
		else:
			stop
	else:
		stop

on block break:
	name of player's helmet is "&a矿工套装头盔"
	name of player's chestplate is "&a矿工套装胸甲"
	name of player's leggings is "&a矿工套装护腿"
	name of player's boots is "&a矿工套装靴子"
	remove haste from player
	apply haste 2 to the player for 10 seconds
	stop

on death:
	attacker is a player
	victim is not a player
	name of attacker's helmet is "&9傀儡头盔"
	name of attacker's chestplate is "&9傀儡胸甲"
	name of attacker's leggings is "&9傀儡护腿"
	name of attacker's boots is "&9傀儡靴子"
	remove absorption from attacker
	apply absorption 3 to the attacker for 20 seconds
	stop

on damage:
	attacker is a player
	name of attacker's helmet is "&f南瓜头盔"
	name of attacker's chestplate is "&f南瓜胸甲"
	name of attacker's leggings is "&f南瓜护腿"
	name of attacker's boots is "&&f南瓜靴子"
	set damage to damage * 1.1
	stop

on damage:
	victim is a player
	name of victim's helmet is "&f南瓜头盔"
	name of victim's chestplate is "&f南瓜胸甲"
	name of victim's leggings is "&f南瓜护腿"
	name of victim's boots is "&&f南瓜靴子"
	set damage to damage * 0.9
	stop

on damage:
	victim is a player
	name of victim's helmet is "&f仙人掌头盔"
	name of victim's chestplate is "&f仙人掌胸甲"
	name of victim's leggings is "&f仙人掌护腿"
	name of victim's boots is "&f仙人掌靴子"
	damage the attacker by 3
	stop

on damage:
	victim is a player
	name of victim's helmet is "&5极速头盔"
	name of victim's chestplate is "&5极速胸甲"
	name of victim's leggings is "&5极速护腿"
	name of victim's boots is "&5极速靴子"
	remove speed from victim
	apply speed 2 to the victim for 6 seconds
	stop