#		send formatted "  &c* <tooltip:&d点击选择!><link:http://mc.server.net/>&bGeneral Gameplay/Server<reset>"
		send formatted "  &c* <tooltip:&d点击选择!><link:https://mcciv.cn/>&b文明游戏官网<reset>"
		send formatted "  &c* <tooltip:&d点击选择!><link:https://space.bilibili.com/1803912517>&b官方哔哩哔哩账号<reset>"
